# --- Google Sheets -------------------------------------------------------
# Путь к JSON-ключу сервисного аккаунта (относительно корня проекта)
GOOGLE_CREDENTIALS_FILE=service_account.json

# Идентификатор Google Таблицы из её URL:
# https://docs.google.com/spreadsheets/d/<SPREADSHEET_ID>/edit
SPREADSHEET_ID=

# Права доступа (по умолчанию достаточно редактирования таблиц)
GOOGLE_SCOPES=https://www.googleapis.com/auth/spreadsheets

# --- AITunnel (OpenAI-совместимый API) ----------------------------------
AITUNNEL_API_KEY=
AITUNNEL_BASE_URL=https://api.aitunnel.ru/v1
AITUNNEL_MODEL=deepseek-v4.1-flash-1017

# Таймаут запроса к ИИ, секунды
AI_TIMEOUT=30
# Количество повторных попыток
AI_RETRIES=2

# --- Прочее --------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO

# Зерно генератора случайных данных (пусто — каждый раз новое)
REPORT_SEED=
